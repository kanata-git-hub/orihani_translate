rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for all documents
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'kanata840@gmail.com';
    }

    // Admin dashboard collection
    match /approved_users/{docId} {
      allow read, write: if isAdmin();
    }

    // Generic user data example
    match /user_data/{docId} {
      allow read, update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (request.auth != null && request.resource.data.userId == request.auth.uid);
    }
  }
}
